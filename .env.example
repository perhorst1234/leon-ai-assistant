# Leon AI Assistant local environment
# Copy values through the dashboard instead of editing secrets into tracked files.

# Required later for OpenAI-hosted model calls.
OPENAI_API_KEY=

# Optional for single-invocation Codex automation.
# Prefer passing this only to the specific codex exec process that needs it.
CODEX_API_KEY=

# Optional later if Anthropic-backed coding/research agents are enabled.
ANTHROPIC_API_KEY=

# Optional later for GitHub issue/PR/repo automation.
GITHUB_TOKEN=

# Optional later for traces, evals, and cost/quality monitoring.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Local dashboard/runtime knobs.
LEON_DASHBOARD_PORT=8765
LEON_DASHBOARD_AUTH_MODE=tailnet
LEON_DASHBOARD_TOKEN=
# Local server status is read-only and enabled by default; no credentials required.
LEON_SERVER_MONITOR_ENABLED=true
LEON_MODEL_BUDGET_MODE=balanced
LEON_LOCAL_GPU_ENABLED=false
LEON_RESUME_DEFAULT_WAIT_SECONDS=900
LEON_RESUME_MAX_ATTEMPTS=50

# Optional, disabled by default. Search-only Firecrawl v2 requires both the
# feature flag and a key; keep the domain allowlist explicit and small.
RESEARCH_EXECUTOR_ENABLED=false
FIRECRAWL_API_KEY=
RESEARCH_ALLOWED_DOMAINS=

# Optional, disabled when empty. Absolute path to private rootless Podman policy.
# Preview binds exact policy/image before approval; changed code runs only there.
LEON_SELF_IMPROVEMENT_SANDBOX_CONFIG=
