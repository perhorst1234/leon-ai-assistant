{
  "version": 1,
  "default_budget_mode": "balanced",
  "cost_policy": {
    "currency": "USD",
    "basis": "Planning estimate for a single bounded Leon agent/model call before exact token metering is available.",
    "warning_threshold_estimated_max": 0.08
  },
  "cloud_models": {
    "cheap": {
      "provider": "openai",
      "model": "gpt-5.6-luna",
      "reasoning_effort": "low",
      "relative_cost": "low",
      "default_run_estimate": {
        "estimated_min": 0.001,
        "estimated_max": 0.015
      },
      "use_for": [
        "classification",
        "extraction",
        "housekeeping",
        "small summaries",
        "schema transforms",
        "clear repeatable tasks"
      ]
    },
    "balanced": {
      "provider": "openai",
      "model": "gpt-5.6-terra",
      "reasoning_effort": "medium",
      "relative_cost": "medium",
      "default_run_estimate": {
        "estimated_min": 0.01,
        "estimated_max": 0.08
      },
      "use_for": [
        "everyday coding",
        "debugging",
        "tool implementation",
        "documentation",
        "routine research"
      ]
    },
    "premium": {
      "provider": "openai",
      "model": "gpt-5.6-sol",
      "reasoning_effort": "high",
      "requires_reason": true,
      "relative_cost": "high",
      "default_run_estimate": {
        "estimated_min": 0.05,
        "estimated_max": 0.35
      },
      "use_for": [
        "complex planning",
        "code review",
        "architecture",
        "security-sensitive review",
        "sensitive decisions",
        "complex product decisions",
        "hard debugging",
        "high-value agent orchestration"
      ]
    }
  },
