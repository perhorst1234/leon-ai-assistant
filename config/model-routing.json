    "preferred_backend_order": [
      "ollama",
      "llama.cpp",
      "exllamav2",
      "vllm-if-supported"
    ],
    "hardware_targets": [
      "NVIDIA Tesla M40",
      "NVIDIA Tesla P40",
      "other NVIDIA GPU"
    ],
    "policy": "Local GPU is an optimization and privacy route, not a hard dependency. Use it for low/medium-risk local inference only after benchmark, driver validation, backend healthcheck and fallback evidence.",
    "validation_required": [
      "gpu_detected_by_lspci_and_nvidia_smi",
      "driver_stable",
      "backend_healthcheck_passed",
      "small_quantized_model_benchmark_passed",
      "realistic_leon_task_benchmark_passed",
      "cloud_or_cpu_fallback_passed",
      "redacted_benchmark_log_recorded"
    ],
    "resource_policy": {
      "model_download_requires_approval": true,
      "gpu_heavy_job_requires_approval": true,
      "default_max_gpu_minutes_without_new_approval": 5,
      "default_download_mb_approval_threshold": 500,
      "public_model_server_allowed": false,
      "high_risk_tasks_allowed_on_local_gpu_before_quality_evals": false
    },
    "runtime_policy": {
      "max_latency_ms": 3500,
      "fallback_on": [
        "local_failure",
        "latency_exceeds_threshold"
      ],
      "fallback_route": "api_policy_selected"
    }
  },
  "routing_rules": [
    {
      "match": {
        "complexity": "low",
        "risk": "low"
      },
      "route": "cheap"
    },
    {
      "match": {
        "task_type": "tool_making"
      },
      "route": "balanced"
    },
    {
      "match": {
        "task_type": "debugging"
      },
      "route": "balanced"
    },
    {
      "match": {
        "task_type": "architecture"
      },
      "route": "premium"
    },
    {
      "match": {
        "risk": "high"
      },
      "route": "premium"
    }
  ],
  "approval_required": [
    "max_reasoning",
    "ultra_multi_agent",
    "large_local_model_download",
    "gpu_intensive_job",
    "new_external_provider",
    "model_route_that_exposes_sensitive_data"
  ]
}
