#!/usr/bin/env bash
set -euo pipefail
repo_root=$(cd "$(dirname "$0")/.." && pwd -P)
python="$repo_root/.venv/bin/python"
[ -x "$python" ] || { printf '%s\n' 'Run scripts/leon-setup first; Python 3.13 environment is required.' >&2; exit 69; }
exec "$python" -m leon_control_plane.marktplaats_mcp "$@"
