#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export OLLAMA_HOST="${OLLAMA_HOST:-127.0.0.1:11434}"
opencode_bin="$HOME/.local/share/leon-opencode/node_modules/.bin/opencode"
if [[ ! -x "$opencode_bin" ]]; then
  echo "Install OpenCode in ~/.local/share/leon-opencode before using this coding agent." >&2
  exit 2
fi
model="${LEON_CODING_MODEL_NAME:-gpt-oss:20b}"
if [[ ! "$model" =~ ^[A-Za-z0-9._:-]+$ ]]; then
  echo "LEON_CODING_MODEL_NAME must be an Ollama model name" >&2
  exit 2
fi
max_temp="${LEON_M40_CODING_MAX_TEMP_C:-89}"
if [[ ! "$max_temp" =~ ^[0-9]+$ ]] || (( max_temp < 65 || max_temp > 89 )); then
  echo "LEON_M40_CODING_MAX_TEMP_C must be an integer from 65 through 89" >&2
  exit 2
fi

cd "$repo_root"
mkdir -p "$HOME/.local/state/leon"
exec 9> "$HOME/.local/state/leon/m40.lock"
chmod 600 "$HOME/.local/state/leon/m40.lock"
if ! flock -n 9; then
  echo "M40 is currently serving another Leon request; retry the coding task later." >&2
  exit 75
fi
if ! "$repo_root/.venv/bin/python" -m leon_control_plane.gpu_lease; then
  echo "M40 has queued Leon requests; defer this coding task." >&2
  exit 75
fi
"$repo_root/.venv/bin/python" -m leon_control_plane.thermal_guard --check
if [[ "${LEON_CODING_COMPACT:-0}" == "1" ]]; then
  export OPENCODE_CONFIG_CONTENT="$(cat "$repo_root/config/m40-compact-agent.json")"
  export OPENCODE_DISABLE_PROJECT_CONFIG=1
  export OPENCODE_DISABLE_CLAUDE_CODE=1
  export OPENCODE_DISABLE_MODELS_FETCH=1
  export OPENCODE_DISABLE_LSP_DOWNLOAD=1
fi
max_seconds="${LEON_M40_CODING_TIMEOUT_SECONDS:-600}"
exec "$repo_root/.venv/bin/python" -m leon_control_plane.coding_process \
  --limit "$max_temp" --seconds "$max_seconds" --model "$model" -- \
  "$opencode_bin" --pure --model "ollama/$model" "$@"
