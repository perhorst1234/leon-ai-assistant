#!/usr/bin/env python3
"""Run a Quick Tunnel and publish its current exact origin for CSRF checks."""

from __future__ import annotations

import os
import re
import signal
import subprocess
import sys
from pathlib import Path


origin_file = Path.home() / "leon-ai-assistant/.runtime/leon-temp-origin"
url_pattern = re.compile(r"https://[a-z]+(?:-[a-z]+)*\.trycloudflare\.com")
cloudflared = str(Path.home() / ".local/bin/cloudflared")
process = subprocess.Popen(
    [cloudflared, "tunnel", "--no-autoupdate", "--url", "http://127.0.0.1:3000"],
    stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, bufsize=1,
)


def stop(_signum: int, _frame: object) -> None:
    process.terminate()


signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
active = ""
try:
    assert process.stderr is not None
    for line in process.stderr:
        match = url_pattern.search(line)
        if match:
            active = match.group()
            temporary = origin_file.with_suffix(".new")
            with temporary.open("w") as handle:
                handle.write(active + "\n")
            temporary.chmod(0o600)
            os.replace(temporary, origin_file)
            print(f"Temporary Leon URL: {active}", flush=True)
        elif " ERR " in line:
            print(line.strip(), file=sys.stderr, flush=True)
finally:
    if process.poll() is None:
        process.terminate()
    process.wait()
    if active and origin_file.exists() and origin_file.read_text().strip() == active:
        origin_file.unlink()
raise SystemExit(process.returncode)
