[Unit]
Description=Leon local control plane
After=network.target leon-ollama.service
Wants=leon-ollama.service

[Service]
Type=simple
WorkingDirectory=%h/leon-ai-assistant
EnvironmentFile=%h/leon-ai-assistant/.env.local
Environment=LEON_DB_PATH=%h/leon-ai-assistant/.runtime/control-plane.sqlite
ExecStart=%h/leon-ai-assistant/.venv/bin/python -m leon_control_plane.server --host 127.0.0.1 --port 8765 --db %h/leon-ai-assistant/.runtime/control-plane.sqlite --seed %h/leon-ai-assistant/state/control-plane.seed.json --env-file %h/leon-ai-assistant/.env.local
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
