[Unit]
Description=Leon local web app
After=leon-backend.service

[Service]
Type=simple
WorkingDirectory=%h/leon-ai-assistant/apps/web
EnvironmentFile=%h/leon-ai-assistant/.env.local
Environment=LEON_BACKEND_URL=http://127.0.0.1:8765
Environment=PATH=%h/.local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/npm run start -- --hostname 0.0.0.0 --port 3000
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
