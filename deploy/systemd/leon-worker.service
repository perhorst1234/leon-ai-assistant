[Unit]
Description=Leon local worker
After=leon-backend.service

[Service]
Type=simple
WorkingDirectory=%h/leon-ai-assistant
EnvironmentFile=%h/leon-ai-assistant/.env.local
Environment=LEON_DB_PATH=%h/leon-ai-assistant/.runtime/control-plane.sqlite
ExecStart=%h/leon-ai-assistant/.venv/bin/python -m leon_control_plane.local_worker --db %h/leon-ai-assistant/.runtime/control-plane.sqlite --seed %h/leon-ai-assistant/state/control-plane.seed.json --env-file %h/leon-ai-assistant/.env.local
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
