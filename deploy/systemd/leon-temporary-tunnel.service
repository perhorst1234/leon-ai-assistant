[Unit]
Description=Leon temporary HTTPS fallback for networks without NAT loopback
After=network-online.target leon-web.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/leon-ai-assistant/scripts/leon-temporary-tunnel
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
