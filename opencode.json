{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/gpt-oss:20b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Ollama on Tesla M40",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen2.5-coder:14b": {
          "name": "Qwen 2.5 Coder 14B (M40)",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "gpt-oss:20b": {
          "name": "GPT-OSS 20B coding tools (M40)",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*/.runtime/*": "deny"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "git status*": "allow",
      "rg *": "allow",
      "head README.md": "allow"
    },
    "external_directory": "deny",
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
